# Firebase Web 設定
# 步驟：
#   1. 複製本檔為 .env
#   2. 去 Firebase Console（https://console.firebase.google.com/）
#      -> Project settings -> Your apps -> 複製 Web App 嘅 firebaseConfig 數值
#   3. 填返下面，然後重啟 `npm run dev`
#
# 注意：只有以 VITE_ 開頭嘅變數先會被 Vite 注入前端
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# =====================================================================
# AAI AI Homework Portal（Supabase）—— workflow 清單來源（可選）
# 唔填就用返 src/lib/localInventory.ts 嘅本機資料。
# 真實 table 名：ai_units / workflow_inventory
# ⚠️ 唔好 commit 內部位址／key 落 repo —— 用自己嘅值。
# =====================================================================
VITE_PORTAL_SUPABASE_URL=https://your-project.supabase.co
VITE_PORTAL_SUPABASE_ANON_KEY=your-portal-publishable-key
VITE_PORTAL_UNITS_TABLE=ai_units
VITE_PORTAL_WORKFLOWS_TABLE=workflow_inventory
VITE_PORTAL_UNIT_COL=unit_id
VITE_PORTAL_UNIT_NAME_COL=name

# =====================================================================
# 🔐 Portal 登入 —— 身份清單 + 密碼
#
# ⚠️ 呢批值**唔會 commit 落 repo**，亦**唔應該**填真值入本檔。
#    正式使用時放喺本機 .env（已被 .gitignore 忽略）。
#
# 冇填 = 登入唔到（fail-closed）＋ 登入頁會顯示「未設定」提示。
# =====================================================================

# 部門清單（逗號分隔）
VITE_PORTAL_DEPT_NAMES=Department One,Department Two
# 業務單位清單（逗號分隔）
VITE_PORTAL_BUSINESS_NAMES=Business Unit One,Business Unit Two

# 密碼
VITE_PORTAL_CEO_PASSWORD=your-ceo-password
VITE_PORTAL_STEERING_PASSWORD=your-steering-password
# 單位密碼 = 單位英文名頭 3 個字母 + 呢個尾碼
VITE_PORTAL_UNIT_PASSWORD_SUFFIX=your-unit-suffix
